# Skopiuj do .env i dopasuj do siebie.
APP_NAME="Przewodnik Przyszłego Rodzica API"
ENVIRONMENT=dev
API_PREFIX=/api
# Adresy frontendu rozdzielone przecinkami.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Asystent nawigacyjny. Pusty klucz zostawia tryb demo z katalogu tematów.
ASSISTANT_API_KEY=
ASSISTANT_MODEL=deepseek/deepseek-v4.1-flash
ASSISTANT_BASE_URL=https://openrouter.ai/api/v1
